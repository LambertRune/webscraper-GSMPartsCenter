## API
# PORT=3100

## Cloudflare Tunnel (if used)
# TUNNEL_TOKEN=

## MobileSentrix DeviceSystem CSV source
MS_SOURCE_URL=https://www.mobilesentrix.eu/devicesystem?instock=1
MS_USERNAME=
MS_PASSWORD=
MS_TIMEOUT_MS=90000

## Puppeteer (optional)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

## DeviceSystem sync inputs/outputs
# DEVICESYSTEM_CSV_PATH=/absolute/path/to/device_system.csv
# DEVICESYSTEM_DOWNLOAD_DIR=/absolute/path/to/download/dir

## Webshop push (optional): receives POST { "products": [...] }
# WEBSHOP_WEBHOOK_URL=
# WEBSHOP_WEBHOOK_TOKEN=
# WEBSHOP_BATCH_SIZE=50
# WEBSHOP_BATCH_DELAY_MS=250
# DRY_RUN=true

## Cron control (container timezone)
ENABLE_GSM_CRON=true
# Sunday evening (default): 22:00 Sunday
GSM_CRON_SCHEDULE=0 22 * * 0
# Optional: run GSM scrape once on container start
GSM_RUN_ON_STARTUP=false

# MobileSentrix disabled by default; enable if creds set
ENABLE_MOBILESENTRIX_CRON=false
MS_CRON_SCHEDULE=30 21 * * *
# Run sync once on container start if file missing
MOBILESENTRIX_RUN_ON_STARTUP=true

